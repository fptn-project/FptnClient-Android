<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="00dp"
    android:paddingTop="5dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/iv_country"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="5dp"
        android:text="@string/list_point" />

    <TextView
        android:id="@+id/tv_country_flag_emoji"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:textSize="20sp"
        android:visibility="gone"
        tools:text=" "
        tools:visibility="visible" />

    <TextView
        android:id="@+id/fptn_server_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="38dp"
        android:layout_toEndOf="@id/iv_country"
        android:textColor="@color/white"
        tools:text="United Kingdom" />

    <TextView
        android:id="@+id/fptn_server_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/fptn_server_name"
        android:textColor="@color/white"
        tools:text="192.168.0.0" />

    <ImageView
        android:id="@+id/censoredIcon"
        android:layout_width="18dp"
        android:layout_height="22dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/fptn_server_host"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_logo" />

</RelativeLayout>
