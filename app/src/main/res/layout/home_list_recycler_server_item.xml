<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="20dp"
    android:paddingTop="10dp"
    android:paddingRight="20dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/iv_country"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_logo"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tv_country_flag_emoji"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/iv_country"
        android:gravity="center"
        android:textSize="20sp"
        android:visibility="gone"
        tools:text=" "
        tools:visibility="visible" />

    <TextView
        android:id="@+id/server_ping"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/tv_country_flag_emoji"
        android:textAlignment="viewEnd"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="9999ms"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/fptn_server_host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/server_ping"
        android:textColor="@color/primary"
        android:textSize="24sp"
        tools:text="192.168.0.0" />

    <TextView
        android:id="@+id/fptn_server_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/fptn_server_host"
        android:textColor="@color/primary"
        tools:text="United Kingdom" />

    <ImageView
        android:id="@+id/censoredIcon"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/fptn_server_name"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_logo"
        app:tint="@color/primary" />

</RelativeLayout>
