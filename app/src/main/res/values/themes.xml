<resources>
    <style name="NoAnimations">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Base.Theme.FptnClient" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoAnimations</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.FptnClient" parent="Base.Theme.FptnClient">
        <item name="android:windowAnimationStyle">@style/NoAnimations</item>
    </style>

    <style name="Theme.Splash" parent="Base.Theme.FptnClient">
        <item name="android:windowBackground">@drawable/application_background</item>
    </style>

    <style name="Theme.RemoveSplashScreenTheme" parent="Base.Theme.FptnClient">
    </style>
</resources>