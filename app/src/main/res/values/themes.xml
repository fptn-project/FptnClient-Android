<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FptnClient" parent="@style/Theme.AppCompat.NoActionBar"/>
    <style name="Theme.FptnClient" parent="Base.Theme.FptnClient" />
<!--    <item name="android:windowIsTranslucent">true</item>-->
    <style name="Theme.Splash" parent="Base.Theme.FptnClient">
        <item name="android:windowBackground">@drawable/application_background</item>
        <!-- Set a transparent .png as your icon -->
<!--        <item name="android:windowSplashScreenAnimatedIcon">@drawable/dowload</item>-->
    </style>
    <style name="Theme.RemoveSplashScreenTheme" parent="Base.Theme.FptnClient">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Allows us to override night specific attributes in the
     values-night folder. -->
    <style name="NightAdjusted.Theme.FptnClient" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The final theme we use -->
    <style name="Theme.MoneyManager" parent="NightAdjusted.Theme.FptnClient" />

    <style name="NightAdjusted.Theme.Splash" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.FptnClient.Splash" parent="NightAdjusted.Theme.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="postSplashScreenTheme">@style/Theme.FptnClient</item>
    </style>
</resources>
